<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- CPU Usage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="CPU"
                android:textColor="@color/widget_label_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/cpu_usage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="00%"
                android:textColor="#FF0000"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/cpu_graph"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitXY"
            android:contentDescription="CPU Graph" />
    </LinearLayout>

    <!-- Memory Usage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="RAM"
                android:textColor="@color/widget_label_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/memory_usage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="00%"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/memory_graph"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitXY"
            android:contentDescription="Memory Graph" />
    </LinearLayout>

    <!-- Battery Level -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="BAT"
                android:textColor="@color/widget_label_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/battery_level_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="00%"
                android:textColor="#0099FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/battery_graph"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitXY"
            android:contentDescription="Battery Graph" />
    </LinearLayout>

    <!-- Network Speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="NET"
                android:textColor="@color/widget_label_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/network_speed_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/led_dot_matrix"
                android:letterSpacing="0.1"
                android:text="0M"
                android:textColor="#0099FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/network_graph"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitXY"
            android:contentDescription="Network Graph" />
    </LinearLayout>

</LinearLayout>
