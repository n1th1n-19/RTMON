{
  "expo": {
    "name": "RTMON",
    "slug": "rtmon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nothing.systemwidget",
      "permissions": [
        "android.permission.BATTERY_STATS",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 23
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7f14400b-a1ae-48c4-bffb-4e65f8f6d2d8"
      }
    },
    "owner": "nthnpy"
  }
}
